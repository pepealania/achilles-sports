# ==============================================================================
# ENVIRONMENT VARIABLES EXAMPLE (.env.example)
# Duplicate this file as '.env' and fill in your actual credentials.
# Do not commit your final '.env' file to version control.
# ==============================================================================

# --- System & Environment Setup ---
ENV=development # development, staging, production
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR
SECRET_KEY=your_super_secret_core_system_key_here

# --- Database & Storage Configuration (data/ directory) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=achilles_sports_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Local or Cloud Storage Data Paths
DATA_DIR_PATH=./data
S3_BUCKET_NAME=your-achilles-sports-bucket-name
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# --- Third-Party Sports APIs (ingestion/ & integrations/ directories) ---
# Example: Sportradar, Odds API, API-Football, etc.
SPORTS_API_PROVIDER_URL=https://example-sports.com
SPORTS_API_KEY=your_sports_data_api_key_here
ODDS_API_KEY=your_odds_provider_api_key_here

# --- Intelligence & Machine Learning (forecasting/ & intelligence/ directories) ---
# OpenAI or other LLM/ML provider tracking keys if using AI agents or smart insights
OPENAI_API_KEY=your_openai_api_key_here
MODEL_VERSION=gpt-4o

# --- Analytics & Tracking (analytics/ directory) ---
# If you are piping tracking/event analytics to a dashboard or platform
ANALYTICS_WRITE_KEY=your_analytics_platform_token_here

# --- Synthetic Data Generation (synthetic/ directory) ---
# Toggle or seed configurations for testing environments
SYNTHETIC_DATA_SEED=42
GENERATE_DUMMY_HISTORICAL_DATA=true
